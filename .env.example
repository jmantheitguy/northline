NORTHLINE_ADMIN_EMAIL=admin@example.com
NORTHLINE_ADMIN_PASSWORD=replace-with-a-long-random-password
# Keep SQLite for local development. Set postgres only after the guarded import.
NORTHLINE_DB_DRIVER=sqlite
# Required when NORTHLINE_DB_DRIVER=postgres; keep the value in the provider's secret store.
# DATABASE_URL=postgresql://...
NORTHLINE_DATA_DIR=/app/data
NORTHLINE_PUBLIC_URL=https://northline.example.com
NORTHLINE_COOKIE_SECURE=true
NORTHLINE_OIDC_ISSUER=https://auth.example.com/application/o/northline
NORTHLINE_OIDC_CLIENT_ID=copy-from-authentik
NORTHLINE_OIDC_CLIENT_SECRET=copy-from-authentik
NORTHLINE_AUTHENTIK_API_URL=https://auth.example.com
NORTHLINE_AUTHENTIK_API_TOKEN=create-an-authentik-service-token
NORTHLINE_DISCORD_BOT_TOKEN=create-a-discord-bot-token
NORTHLINE_DISCORD_GUILD_ID=copy-your-discord-server-id
NORTHLINE_RELEASE_CHANNEL_ID=copy-your-release-announcement-channel-id
