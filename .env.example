NORTHLINE_ADMIN_EMAIL=admin@example.com
NORTHLINE_ADMIN_PASSWORD=replace-with-a-long-random-password
# PostgreSQL is the local development/runtime default. Use an isolated local
# database; never point local development at Railway production.
NORTHLINE_DB_DRIVER=postgres
NORTHLINE_POSTGRES_DB=northline
NORTHLINE_POSTGRES_USER=northline
NORTHLINE_POSTGRES_PASSWORD=replace-with-a-local-only-password
DATABASE_URL=postgresql://northline:replace-with-a-local-only-password@127.0.0.1:55432/northline
NORTHLINE_DATA_DIR=/app/data
NORTHLINE_PUBLIC_URL=http://localhost:3000
NORTHLINE_COOKIE_SECURE=false
# Optional integrations for local development; configure privately when used.
NORTHLINE_OIDC_ISSUER=
NORTHLINE_OIDC_CLIENT_ID=
NORTHLINE_OIDC_CLIENT_SECRET=
NORTHLINE_AUTHENTIK_API_URL=
NORTHLINE_AUTHENTIK_API_TOKEN=
NORTHLINE_DISCORD_BOT_TOKEN=
NORTHLINE_DISCORD_GUILD_ID=
# Comma-separated channel IDs. The singular variable remains supported for one-channel deployments.
NORTHLINE_RELEASE_CHANNEL_IDS=channel-id-for-server-one,channel-id-for-server-two
NORTHLINE_RELEASE_CHANNEL_ID=copy-your-release-announcement-channel-id
