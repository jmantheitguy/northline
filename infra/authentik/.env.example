# Copy this file to .env on the server. Never commit the resulting .env file.
PG_DB=authentik
PG_USER=authentik
PG_PASS=generate-a-long-random-value
AUTHENTIK_SECRET_KEY=generate-a-long-random-value

# Pin upgrades deliberately after reviewing Authentik release notes.
AUTHENTIK_TAG=2026.5.6
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443
